# Twin — the ONE environment file. Copy to `.env` at the repo root (git-ignored) and fill in.
# It is read by the web app (Next.js), the Python backend (npm run backend) and Docker Compose.
# Integration settings can also be changed at runtime in Admin → Integrations (the web app).

# ── Meta Model API (required for AI features) ─────────────────────────────
# Key from https://dev.meta.ai. Powers Muse Spark, Muse Wonder, Muse Image,
# SAM 3.1 and Muse Voice Transcribe. Without it Twin runs fully deterministic.
MODEL_API_KEY=
# Agents, copilot, Twin Builder, footage review, backend copilots and AOI
META_MODEL=muse-spark-1.3
# Decision briefings and planning narratives (falls back to META_MODEL on failure)
META_REASONING_MODEL=muse-wonder-1.0
# Defect localisation and synthetic inspection images (backend)
META_SEGMENTATION_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0
# Deployment-only override of the API base URL
# META_API_BASE=https://api.meta.ai/v1
AI_ENABLED=true
# Request timeouts: web app (ms) and backend (s)
AI_TIMEOUT_MS=60000
AI_TIMEOUT_S=60

# ── Meta open-weight models on Baseten (Muse Spark Open) ──────────────────
# Key from https://www.baseten.co → API keys. Powers Plant-Private AI → Blueprint to Twin.
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_BASE_URL=https://inference.baseten.co/v1

# ── App ───────────────────────────────────────────────────────────────────
# Passcode that unlocks Features, Integrations and camera sources
TWIN_ADMIN_KEY=
# Local (default) or public. On a public deployment admin always needs TWIN_ADMIN_KEY.
TWIN_DEPLOYMENT=local
# SQLite database shared by the web app and the backend (default .data/twin.db)
# TWIN_DATA_DIR=.data
# TWIN_DB_PATH=.data/twin.db
# MCP endpoint for external agents; set a token to require Authorization: Bearer <token>
TWIN_MCP_ENABLED=true
TWIN_MCP_TOKEN=
# Token for the backend's own MCP server (backend/mcp)
MCP_AUTH_TOKEN=

# ── Python intelligence backend ───────────────────────────────────────────
# Default http://localhost:8000 locally; Docker Compose sets http://backend:8000
INTELLIGENCE_BACKEND_URL=
# Shared bearer token: the web app sends it, the backend requires it when set (openssl rand -hex 24)
INTELLIGENCE_BACKEND_TOKEN=

# ── Vision service (services/vision, OpenCV) ──────────────────────────────
# e.g. http://localhost:8080; Docker Compose sets http://vision:8080
VISION_SERVICE_URL=
VISION_SERVICE_TOKEN=

# ── Telemetry over MQTT (open source: Mosquitto, EMQX) ───────────────────
# simulated | mqtt   (docker compose --profile mqtt starts Mosquitto at mqtt://mqtt:1883)
TELEMETRY_SOURCE=simulated
MQTT_BROKER_URL=
MQTT_TOPIC=plant/+/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Document storage, S3-compatible (MinIO, SeaweedFS, Ceph, AWS S3) ──────
# docker compose --profile storage starts MinIO at http://storage:9000
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
