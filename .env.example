# Twin — environment template. Copy to .env.local (git-ignored) and fill in.
# Every setting below can also be changed at runtime in Admin → Integrations.

# ── Meta Model API (required for AI features) ─────────────────────────────
# Key from https://dev.meta.ai. Powers Muse Spark, Muse Wonder, Muse Image,
# SAM 3.1 and Muse Voice Transcribe. Without it Twin runs fully deterministic.
MODEL_API_KEY=
# Agents, copilot, Twin Builder, footage review
META_MODEL=muse-spark-1.3
# Decision briefings (falls back to META_MODEL on failure)
META_REASONING_MODEL=muse-wonder-1.0
# Deployment-only override of the API base URL
# META_API_BASE=https://api.meta.ai/v1
AI_ENABLED=true
AI_TIMEOUT_MS=60000

# ── App ───────────────────────────────────────────────────────────────────
# Passcode that unlocks camera sources and integration settings
TWIN_ADMIN_KEY=
# Where factory state is stored (default .data)
# TWIN_DATA_DIR=.data
# MCP endpoint for external agents; set a token to require Authorization: Bearer <token>
TWIN_MCP_ENABLED=true
TWIN_MCP_TOKEN=

# ── Optional integrations ─────────────────────────────────────────────────
# Python vision service (services/vision), e.g. http://localhost:8000
VISION_SERVICE_URL=
VISION_SERVICE_AUTH=none
# Google Cloud data integrations (optional; not used for AI)
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=
PUBSUB_TELEMETRY_SUBSCRIPTION=
TELEMETRY_SOURCE=simulated
GCS_BUCKET=
# TWIN_CONFIG_BUCKET=
MQTT_BROKER_URL=
MQTT_TOPIC=
