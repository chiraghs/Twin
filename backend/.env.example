# Twin backend — copy to backend/.env (git-ignored)
# Meta Model API: Muse Spark, Muse Wonder, SAM 3.1, Muse Image. Without a key every feature is deterministic.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_REASONING_MODEL=muse-wonder-1.0
META_SEGMENTATION_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0
# META_API_BASE=https://api.meta.ai/v1
AI_ENABLED=true
AI_TIMEOUT_S=60
MCP_AUTH_TOKEN=
# SQLite database shared with the web app (default <repo>/.data/twin.db)
# TWIN_DATA_DIR=.data
# TWIN_DB_PATH=.data/twin.db
